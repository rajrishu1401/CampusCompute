        <mxCell id="term-step1" value="1. Click 'Open Terminal' Button" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="browser-section">
          <mxGeometry x="20" y="50" width="280" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="term-step2" value="2. Initialize xterm.js&#xa;&#xa;const terminal = new Terminal();&#xa;terminal.open(document.getElementById('terminal'));" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;fontFamily=Courier New;" vertex="1" parent="browser-section">
          <mxGeometry x="20" y="90" width="280" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="term-step3" value="3. Establish WebSocket Connection&#xa;&#xa;const ws = new WebSocket(&#xa;  'wss://campuscompute.college.edu/ws/terminal/cc-9382',&#xa;  ['Bearer', jwt_token]&#xa;);" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;fontFamily=Courier New;" vertex="1" parent="browser-section">
          <mxGeometry x="20" y="160" width="280" height="80" as="geometry" />
