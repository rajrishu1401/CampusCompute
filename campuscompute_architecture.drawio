        <mxCell id="term-step11" value="11. Receive Output via WebSocket&#xa;&#xa;ws.onmessage = (event) => {&#xa;  const msg = JSON.parse(event.data);&#xa;  terminal.write(msg.data);&#xa;};" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;fontFamily=Courier New;" vertex="1" parent="browser-section">
