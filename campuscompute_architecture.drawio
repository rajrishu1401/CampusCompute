            <mxPoint x="140" y="150" as="sourcePoint" />
            <mxPoint x="190" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="step1-details" value="Admin Portal → Backend API&#xa;POST /api/admin/devices/enrollment&#xa;&#xa;Response:&#xa;{&#xa;  &quot;token&quot;: &quot;ENR-a8f3c2d1-4b5e&quot;,&#xa;  &quot;expiresAt&quot;: &quot;2026-08-18T00:00:00Z&quot;&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="520" y="80" width="260" height="100" as="geometry" />
        </mxCell>
        
        <!-- Step 2: Install Agent -->
        <mxCell id="step2-box" value="STEP 2: Install Agent on Lab PC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="220" width="280" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow-step1-step2" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#000000;dashed=1;" edge="1" parent="1" source="step1-box" target="step2-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="340" y="160" as="sourcePoint" />
            <mxPoint x="340" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="step2-details" value="Commands:&#xa;# Install Python &amp; Dependencies&#xa;sudo apt install python3 python3-pip docker.io&#xa;pip3 install -r requirements.txt&#xa;&#xa;# Copy agent files&#xa;sudo cp -r agent/ /opt/campuscompute/&#xa;&#xa;# Create config file&#xa;sudo nano /opt/campuscompute/config.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="520" y="200" width="340" height="120" as="geometry" />
        </mxCell>
        
        <!-- Step 3: Configure Agent -->
        <mxCell id="step3-box" value="STEP 3: Configure Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="340" width="280" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow-step2-step3" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#000000;dashed=1;" edge="1" parent="1" source="step2-box" target="step3-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="340" y="280" as="sourcePoint" />
            <mxPoint x="340" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="step3-details" value="config.yaml:&#xa;&#xa;broker:&#xa;  url: wss://campuscompute.college.edu/ws/agent&#xa;  enrollment_token: ENR-a8f3c2d1-4b5e&#xa;  &#xa;device:&#xa;  lab_name: CS Lab 1&#xa;  location: Building A, Room 205&#xa;  &#xa;resources:&#xa;  cpu_cores: 8&#xa;  ram_gb: 16&#xa;  storage_gb: 512&#xa;  &#xa;docker:&#xa;  socket: /var/run/docker.sock&#xa;  &#xa;heartbeat:&#xa;  interval_seconds: 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="520" y="340" width="340" height="220" as="geometry" />
        </mxCell>
        
        <!-- Step 4: Start Agent -->
        <mxCell id="step4-box" value="STEP 4: Start Agent Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="460" width="280" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow-step3-step4" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#000000;dashed=1;" edge="1" parent="1" source="step3-box" target="step4-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="340" y="400" as="sourcePoint" />
            <mxPoint x="340" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="step4-details" value="# Install as systemd service&#xa;sudo cp campuscompute-agent.service /etc/systemd/system/&#xa;sudo systemctl enable campuscompute-agent&#xa;sudo systemctl start campuscompute-agent&#xa;&#xa;# Check status&#xa;sudo systemctl status campuscompute-agent&#xa;&#xa;# View logs&#xa;sudo journalctl -u campuscompute-agent -f" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="520" y="580" width="340" height="130" as="geometry" />
        </mxCell>
        
        <!-- Agent Startup Sequence -->
