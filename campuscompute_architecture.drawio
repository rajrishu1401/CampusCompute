        <mxCell id="term-step6" value="6. Send Keystrokes via WebSocket&#xa;&#xa;ws.send(JSON.stringify({&#xa;  type: 'input',&#xa;  data: 'ls -la\\n'&#xa;}));" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;fontFamily=Courier New;" vertex="1" parent="browser-section">
